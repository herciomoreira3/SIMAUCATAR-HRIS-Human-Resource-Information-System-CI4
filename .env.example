# Copy values into your deployment secret manager; do not commit a populated .env.
CI_ENVIRONMENT = production
app.baseURL = 'https://example.invalid/'
app.forceGlobalSecureRequests = true
cookie.secure = true

# The production entrypoint maps DB_* and ENCRYPTION_KEY into these CodeIgniter
# settings at runtime. TLS verification must remain enabled for TiDB.
database.default.hostname = 'tidb-host.example.invalid'
database.default.database = 'database_name'
database.default.username = 'database_user'
database.default.password = 'replace-in-secret-manager'
database.default.DBDriver = MySQLi
database.default.port = 4000
database.default.encrypt.ssl_verify = true
database.default.encrypt.ssl_ca = '/run/secrets/tidb-ca.pem'
encryption.key = 'replace-in-secret-manager'

# Off by default. When enabled, logs aggregate timing only, never SQL/bind data.
PERF_TELEMETRY_ENABLED = false

# Optional private S3-compatible durable storage. Keep these values in Render
# secrets; the local driver remains the compatibility default.
storage.driver = 'local'
storage.s3.endpoint = 'https://s3.example.invalid'
storage.s3.bucket = 'private-bucket'
storage.s3.region = 'us-east-1'
storage.s3.accessKey = 'replace-in-secret-manager'
storage.s3.secretKey = 'replace-in-secret-manager'
storage.s3.prefix = 'simaucatar'
storage.s3.pathStyle = true
